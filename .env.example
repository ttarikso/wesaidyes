# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Long random string; protects /admin
ADMIN_SECRET=change-me
# Public site address (used in share links and QR codes)
NEXT_PUBLIC_SITE_URL=https://wesaidyes.site
# How many invitation websites one Etsy order can create (default 1)
NEXT_PUBLIC_INVITES_PER_ORDER=1

# Etsy Open API v3 (Server-side only, DigitarMercato)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_LISTING_IDS=
ETSY_REDIRECT_URI=https://wesaidyes.site/api/admin/etsy/callback
CRON_SECRET=
